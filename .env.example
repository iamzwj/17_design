GRSAI_API_KEY=sk-your-key-here
GRSAI_BASE_URL=https://grsaiapi.com
# Seedance 视频生成（仅保存在服务端；不要把 Key 暴露到前端）
VIBBIT_OPENAPI_KEY=sk-your-vibbit-key-here
# 部署后可由 Seedance 访问的本站公网地址，用于将上传的参考图转换为 HTTPS URL
VIBBIT_PUBLIC_BASE_URL=https://your-domain.example
TAVILY_API_KEY=tvly-your-key-here
PORT=8787
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your-account@163.com
SMTP_PASSWORD=your-163-authorization-code
